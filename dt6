def find_best_exponential_smoothing_model(self):
#Оптимальний вибір моделі експоненціального згладжування
print("\n=== ВИБІР ОПТИМАЛЬНОЇ МОДЕЛІ ===")
models = []
best_aic = np.inf
best_model_type = None
# Тестуємо різні типи моделей
model_types = [
('simple', {'trend': None, 'seasonal': None}),
('holt', {'trend': 'add', 'seasonal': None}),
('holt_damped', {'trend': 'add', 'damped_trend': True, 'seasonal': None}),
]
# Додаємо сезонні моделі тільки якщо достатньо даних
if len(self.series) > 40:
model_types.append(('holtwinters_add', {'trend': 'add', 'seasonal': 'add',
'seasonal_periods': 20}))
# Мультиплікативну сезонність тільки для додатніх значень
if (self.series > 0).all():
model_types.append(('holtwinters_mul', {'trend': 'add', 'seasonal': 'mul',
'seasonal_periods': 20}))
for model_name, params in model_types:
try:
if 'seasonal_periods' in params:
if params['seasonal_periods'] >= len(self.series) // 2:
continue
model = ExponentialSmoothing(self.series, **params)
model_fit = model.fit()
aic = model_fit.aic
models.append({
'model': model_name,
'params': params,
'aic': aic,
'sse': model_fit.sse,
'fit': model_fit
})
print(f"{model_name:15} - AIC: {aic:10.2f}, SSE: {model_fit.sse:10.2f}")
if aic < best_aic:
best_aic = aic
best_model_type = model_name
self.best_model_params = params
self.model_fit = model_fit
except Exception as e:
print(f"{model_name:15} - помилка: {e}")
continue
print(f"\nОПТИМАЛЬНА МОДЕЛЬ: {best_model_type}")
print(f"Параметри: {self.best_model_params}")
print(f"AIC: {best_aic:.2f}")
return best_model_type, models
def process_and_forecast(self, train_ratio=0.8):
#Обробка та екстраполяція даних
print("\n=== ОБРОБКА ТА ЕКСТРАПОЛЯЦІЯ ===")
# Розділення на тренувальну та тестову вибірки
train_size = int(len(self.series) * train_ratio)
train, test = self.series.iloc[:train_size], self.series.iloc[train_size:]
print(f"Тренувальна вибірка: {len(train)} записів")
print(f"Тестова вибірка: {len(test)} записів")
# Навчання моделі на тренувальних даних
model = ExponentialSmoothing(train, **self.best_model_params)
model_fit = model.fit()
# Прогноз на тестовій вибірці
forecast_test = model_fit.forecast(steps=len(test))
# Розрахунок метрик якості
mse = mean_squared_error(test, forecast_test)
rmse = np.sqrt(mse)
mae = mean_absolute_error(test, forecast_test)
# MAPE з обробкою ділення на нуль
try:
mape = mean_absolute_percentage_error(test, forecast_test)
except:
# Альтернативний розрахунок MAPE
mape = np.mean(np.abs((test - forecast_test) / np.where(test == 0, 1, test))) * 100
print(f"\nМЕТРИКИ ЯКОСТІ ПРОГНОЗУ:")
print(f"MSE: {mse:.4f}")
print(f"RMSE: {rmse:.4f}")
print(f"MAE: {mae:.4f}")
print(f"MAPE: {mape:.2f}%")
# Візуалізація результатів обробки
plt.figure(figsize=(14, 10))
# Прогноз vs Реальні значення
plt.subplot(2, 2, 1)
plt.plot(train.index, train, label=
'Тренувальні дані'
, color='blue')
plt.plot(test.index, test, label=
'Реальні значення'
, color='green')
plt.plot(test.index, forecast_test, label=
'Прогноз'
, color='red', linestyle='--')
plt.title('Експоненціальне згладжування: Прогноз vs Реальні значення')
plt.legend()
plt.grid(True)
# Залишки
plt.subplot(2, 2, 2)
residuals = test - forecast_test
plt.plot(residuals, color='purple')
plt.axhline(y=0, color='red', linestyle='--')
plt.title('Залишки прогнозу')
plt.grid(True)
# Згладжені значення
plt.subplot(2, 2, 3)
fitted_values = model_fit.fittedvalues
plt.plot(train.index, train, label=
'Оригінальні дані'
, alpha=0.7)
plt.plot(train.index, fitted_values, label=
'Згладжені значення'
, color='orange')
plt.title('Згладжені значення моделі')
plt.legend()
plt.grid(True)
# Гістограма залишків
plt.subplot(2, 2, 4)
plt.hist(residuals, bins=20, alpha=0.7, edgecolor='black', color='lightblue')
plt.axvline(x=0, color='red', linestyle='--')
plt.title('Гістограма залишків')
plt.grid(True)
plt.tight_layout()
plt.show()
return forecast_test, {'MSE': mse, 'RMSE': rmse, 'MAE': mae, 'MAPE': mape}
def extrapolate_data(self, intervals=[0.5, 1.0, 1.5, 2.0]):
#Екстраполяція на різні інтервали
print("\n=== ЕКСТРАПОЛЯЦІЯ НА ІНТЕРВАЛІ ===")
# Навчання фінальної моделі на всіх даних
final_model = ExponentialSmoothing(self.series, **self.best_model_params)
final_model_fit = final_model.fit()
n_obs = len(self.series)
for interval in intervals:
steps = int(n_obs * interval)
print(f"\nЕкстраполяція на {interval} інтервалу ({steps} кроків):")
# Прогноз
forecast = final_model_fit.forecast(steps=steps)
# Візуалізація екстраполяції
plt.figure(figsize=(14, 7))
# Історичні дані
plt.plot(self.series, label=
'Історичні дані'
, color='blue', linewidth=2)
# Екстраполяція
forecast_index = pd.date_range(
start=self.series.index[-1] + pd.Timedelta(days=1),
periods=steps,
freq='D'
)
plt.plot(forecast_index, forecast,
label=f'Екстраполяція на {interval} інтервалу'
,
color='red', linewidth=2)
plt.axvline(x=self.series.index[-1], color='gray', linestyle='--'
, alpha=0.7)
plt.title(f'Експоненціальне згладжування: Екстраполяція на {interval} інтервалу
спостереження')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()
# Статистика екстраполяції
print(f"Перші 10 екстрапольованих значень:")
for i, (idx, val) in enumerate(forecast.head(10).items()):
print(f" Крок {i + 1}: {val:.2f}")
def evaluate_model_kpi(self):
#Оцінювання KPI моделі
print("\n=== ОЦІНЮВАННЯ KPI МОДЕЛІ ===")
if self.model_fit is None:
raise ValueError("Спочатку навчіть модель!")
# Основні KPI
kpis = {
'AIC': self.model_fit.aic,
'BIC': self.model_fit.bic,
'SSE': self.model_fit.sse,
'MSE': self.model_fit.sse / len(self.series),
}
print("КЛЮЧОВІ ПОКАЗНИКИ ЕФЕКТИВНОСТІ (KPI):")
for kpi, value in kpis.items():
print(f"{kpi}: {value:.2f}")
return kpis
