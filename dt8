# Функція для оцінки якості прогнозу
def evaluate_forecast(y_true, y_pred, model_name):
mae = mean_absolute_error(y_true, y_pred)
mape = mean_absolute_percentage_error(y_true, y_pred)
rmse = np.sqrt(mean_squared_error(y_true, y_pred))
print(f"\nОцінка якості ({model_name}):")
print(f" MAE: {mae:.2f}")
print(f" MAPE: {mape:.2%}")
print(f" RMSE: {rmse:.2f}")
# Коефіцієнт детермінації
ss_res = np.sum((y_true - y_pred) ** 2)
ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)
r2 = 1 - (ss_res / ss_tot) if ss_tot != 0 else 0
print(f" R²: {r2:.4f}")
return {'MAE': mae, 'MAPE': mape, 'RMSE': rmse, 'R2': r2}
# Функція для пошуку найкращих параметрів ARIMA
def find_best_arima(y_train, max_p=2, max_d=1, max_q=2):
best_aic = np.inf
best_order = (1, 1, 1) # значення за замовчуванням
print("\nПошук найкращих параметрів ARIMA...")
for p in range(max_p + 1):
for d in range(max_d + 1):
for q in range(max_q + 1):
if p == 0 and d == 0 and q == 0:
continue
try:
model = sm.tsa.ARIMA(y_train, order=(p, d, q))
model_fit = model.fit()
if model_fit.aic < best_aic:
best_aic = model_fit.aic
best_order = (p, d, q)
# print(f" Знайдено кращі параметри: {best_order} (AIC: {best_aic:.2f})")
except:
continue
return best_order, best_aic
