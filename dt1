#Збереження результатів
def save_results_to_csv(self, results: Dict):
summary_data = []
for name, data in results.items():
if 'series_stats' in data:
stats = data['series_stats']
row = {
'Показник': name,
'Середнє': stats.get('mean', 0),
'Дисперсія': stats.get('variance', 0),
'СКВ': stats.get('std', 0),
'Медіана': stats.get('median', 0),
'Асиметрія': stats.get('skewness', 0),
'Ексцес': stats.get('kurtosis', 0),
'Мінімум': stats.get('min', 0),
'Максимум': stats.get('max', 0),
'Нормальність_JB': stats.get('is_normal_jb', False),
'Стаціонарність': data.get('stationarity', {}).get('is_stationary', False) }
summary_data.append(row)
df_summary = pd.DataFrame(summary_data)
df_summary.to_csv(os.path.join(self.output_dir, "statistical_summary.csv"),
index=False, encoding='utf-8')
detailed_results = {}
for name, data in results.items():
if 'data' in data and 'series' in data['data']:
detailed_results[f"{name}_series"] = data['data']['series']
if 'trend' in data['data']:
detailed_results[f"{name}_trend"] = data['data']['trend']
if 'noise' in data['data']:
detailed_results[f"{name}_noise"] = data['data']['noise']
max_len = max(len(arr) for arr in detailed_results.values())
for key in detailed_results:
arr = detailed_results[key]
if len(arr) < max_len:
detailed_results[key] = np.concatenate([arr, np.full(max_len - len(arr), np.nan)])
df_detailed = pd.DataFrame(detailed_results)
df_detailed.to_csv(os.path.join(self.output_dir, "detailed_data.csv"),
index=False, encoding='utf-8')
