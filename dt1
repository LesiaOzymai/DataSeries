#Клас для аналізу дати з генерацією синтетичних даних
class BigDataAnalyzer:
def __init__(self, seed: int = 42):
self.seed = seed
np.random.seed(seed)
self.results = {}
self.output_dir = "lab_results"
os.makedirs(self.output_dir, exist_ok=True)
def generate_noise(self, distribution: str, size: int, **params) -> np.ndarray:
np.random.seed(self.seed)
if distribution == 'normal': # Нормальний розподіл
mu = params.get('mu', 0.0)
sigma = params.get('sigma', 1.0)
return np.random.normal(mu, sigma, size)
elif distribution == 'exponential': # Експоненційний розподіл
scale = params.get('scale', 1.0)
return np.random.exponential(scale, size)
else:
raise ValueError(f"Непідтримуваний розподіл: {distribution}")
#Генерація тренду досліджуваного процесу
def generate_trend(self, trend_type: str, size: int, **params) -> np.ndarray:
t = np.arange(size)
if trend_type == 'constant': # Постійний тренд
C = params.get('C', 100.0)
return np.full(size, C)
elif trend_type == 'quadratic': # Квадратичний тренд
A = params.get('A', 0.01)
B = params.get('B', 0.5)
C = params.get('C', 100.0)
return A * t ** 2 + B * t + C
else:
raise ValueError(f"Непідтримуваний тип тренду: {trend_type}")
#Створення синтетичного ряду як адитивної моделі тренду та шуму
def create_synthetic_series(self, name: str, size: int, trend_config: Dict, noise_config: Dict) ->
Dict[
str, np.ndarray]:
# Генерація тренду
trend = self.generate_trend(**trend_config, size=size)
# Генерація шуму
noise = self.generate_noise(**noise_config, size=size)
# Адитивна модель: X(t) = U(t) + ε(t)
series = trend + noise
return {
'trend': trend,
'noise': noise,
'series': series,
'time': np.arange(size)
}
#Розрахунок статистичних характеристик
def calculate_statistics(self, data: np.ndarray, name: str = "") -> Dict[str, Any]:
data = np.asarray(data).flatten()
data = data[~np.isnan(data)] # Видалення NaN значень
if len(data) == 0:
return {"error": "Немає валідних даних"}
stats_dict = {
'n': len(data),
'mean': np.mean(data), # Математичне очікування
'variance': np.var(data, ddof=0), # Дисперсія
'std': np.std(data, ddof=0), # Середньоквадратичне відхилення
'sample_variance': np.var(data, ddof=1), # Вибіркова дисперсія
'sample_std': np.std(data, ddof=1), # Вибіркове СКВ
'median': np.median(data),
'min': np.min(data),
'max': np.max(data),
'range': np.max(data) - np.min(data),
'skewness': stats.skew(data), # Асиметрія
'kurtosis': stats.kurtosis(data), # Ексцес
'q25': np.percentile(data, 25),
'q75': np.percentile(data, 75)
}
# Тести нормальності
try:
# Тест Д'Агостіно-Пірсона
k2, p_dagostino = normaltest(data)
stats_dict['dagostino_test_stat'] = k2
stats_dict['dagostino_p_value'] = p_dagostino
stats_dict['is_normal_dagostino'] = p_dagostino > 0.05
# Тест Жарка-Бера
jb_stat, jb_p = jarque_bera(data)
stats_dict['jarque_bera_stat'] = jb_stat
stats_dict['jarque_bera_p_value'] = jb_p
stats_dict['is_normal_jb'] = jb_p > 0.05
except Exception as e:
stats_dict['test_error'] = str(e)
return stats_dict
#Побудова гістограми з аналізом розподілу
def plot_histogram_analysis(self, data: np.ndarray, title: str, filename: str):
fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(15, 10))
# Гістограма з щільністю
ax1.hist(data, bins=30, density=True, alpha=0.7, color='skyblue', edgecolor='black')
mu, sigma = stats.norm.fit(data)
x = np.linspace(data.min(), data.max(), 100)
ax1.plot(x, stats.norm.pdf(x, mu, sigma), 'r-', linewidth=2,
label=f'Normal fit (μ={mu:.2f}, σ={sigma:.2f})')
ax1.set_title(f'{title} - Гістограма з підгонкою')
ax1.set_xlabel('Значення')
ax1.set_ylabel('Щільність')
ax1.legend()
ax1.grid(True, alpha=0.3)
# Q-Q plot для нормальності
stats.probplot(data, dist="norm", plot=ax2)
ax2.set_title('Q-Q Plot (Normal)')
ax2.grid(True, alpha=0.3)
# Boxplot
ax3.boxplot(data)
ax3.set_title('Box Plot')
ax3.set_ylabel('Значення')
ax3.grid(True, alpha=0.3)
# Часовий ряд
ax4.plot(data)
ax4.set_title('Часовий ряд')
ax4.set_xlabel('Час')
ax4.set_ylabel('Значення')
ax4.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig(os.path.join(self.output_dir, filename), dpi=300, bbox_inches='tight')
plt.close()
#Аналіз стаціонарності часового ряду
def analyze_stationarity(self, data: np.ndarray) -> Dict[str, Any]:
try:
from statsmodels.tsa.stattools import adfuller
#Тест Дікі-Фуллера
result = adfuller(data, autolag='AIC')
return {
'adf_statistic': result[0],
'adf_p_value': result[1],
'adf_critical_values': result[4],
'is_stationary': result[1] < 0.05,
'used_lags': result[2],
'n_observations': result[3]}
except ImportError:
# Простий тест на постійність середнього
n_parts = 3
part_size = len(data) // n_parts
means = []
for i in range(n_parts):
start_idx = i * part_size
end_idx = start_idx + part_size
means.append(np.mean(data[start_idx:end_idx]))
# F-тест на рівність дисперсій
f_stat, f_p = stats.f_oneway(*[data[i * part_size:(i + 1) * part_size]
for i in range(n_parts)])
return {
'simple_stationarity_test': True,
'part_means': means,
'mean_variation': np.std(means),
'f_statistic': f_stat,
'f_p_value': f_p,
'is_stationary_simple': f_p > 0.05
}
#Завантаження реальних даних з Excel файлу
def load_real_data(self, filepath: str) -> pd.DataFrame:
try:
if filepath.endswith('.xlsx') or filepath.endswith('.xls'):
df = pd.read_excel(filepath)
else:
df = pd.read_csv(filepath)
print(f"Завантажено файл з {len(df)} рядків та стовпцями: {list(df.columns)}")
# Пошук числових стовпців
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
if not numeric_cols:
raise ValueError("У файлі немає числових стовпців")
# Пошук стовпців з валютою
currency_cols = [col for col in df.columns
if any(curr in str(col).upper()
for curr in ['USD', 'EUR', 'UAH',
'КУРС'
, 'RATE'])]
if currency_cols:
value_col = currency_cols[0]
else:
value_col = numeric_cols[0]
print(f"Використовується стовпець для аналізу: {value_col}")
clean_data = df[value_col].dropna()
return pd.DataFrame({
'value': clean_data,
'index': range(len(clean_data))
})
except Exception as e:
print(f"Помилка при завантаженні файлу {filepath}: {e}")
return pd.DataFrame()
